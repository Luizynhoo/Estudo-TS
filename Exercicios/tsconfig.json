{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "rootDir": ".",
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "sourceMap": true
  },
  "include": [
    "ex01/**/*.ts",
    "ex02/**/*.ts",
    "ex03/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}